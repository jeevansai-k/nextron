/* ===================================================================== *
 * NEXTRON -- "Signal" stylesheet                                         *
 *                                                                        *
 * Quiet, violet-tinted neutrals. One accent (the brand violet) marks     *
 * focus and keys. Four signal colours mean state and nothing else.       *
 * Values mirror nextron/core/constants.py (INK_*, ACCENT, SIGNAL_*).     *
 * ===================================================================== */

$ink-bg:      #0E0C13;
$ink-panel:   #14111B;
$ink-raised:  #1D1828;
$ink-select:  #2E2142;
$ink-line:    #2C2638;
$ink-faint:   #6E6780;
$ink-muted:   #A39CB2;
$ink-text:    #ECE9F2;

$accent:      #B48AD0;
$accent-deep: #9B59B6;

$ok:   #5FCF8C;
$warn: #E3B45A;
$err:  #EF6B73;
$busy: #7FB3E6;

Screen {
    background: $ink-bg;
    color: $ink-text;
}

/* --------------------------------------------------------------------- *
 * Chrome: a one-line status header and a quiet footer
 * --------------------------------------------------------------------- */

#app-header {
    height: 1;
    padding: 0 1;
    background: $ink-panel;
    color: $ink-text;
}

Footer {
    background: $ink-panel;
    color: $ink-muted;
}

Footer FooterKey {
    background: $ink-panel;
}

Footer FooterKey .footer-key--key {
    color: $accent;
    background: $ink-panel;
    text-style: bold;
}

Footer FooterKey .footer-key--description {
    color: $ink-muted;
}

/* --------------------------------------------------------------------- *
 * Splash
 * --------------------------------------------------------------------- */

SplashScreen {
    align: center middle;
    background: $ink-bg;
}

#splash-body {
    width: 100%;
    height: auto;
    align: center middle;
}

#splash-banner {
    width: 100%;
    height: auto;
    content-align: center middle;
}

#splash-tagline {
    width: 100%;
    height: auto;
    padding-top: 1;
    color: $ink-muted;
    text-align: center;
}

#splash-status {
    width: 100%;
    height: auto;
    padding-top: 1;
    color: $busy;
    text-align: center;
}

/* --------------------------------------------------------------------- *
 * Dashboard: menu | main | side
 *
 * Deliberately asymmetric: the route and the engines get the width, the
 * menu is only as wide as its labels, and the log sits to the side.
 * --------------------------------------------------------------------- */

#dashboard-body {
    height: 1fr;
    padding: 1 1 0 1;
}

#dashboard-left {
    width: 36;
    height: 100%;
    margin-right: 1;
    scrollbar-size-vertical: 1;
}

#dashboard-mid {
    width: 2fr;
    height: 100%;
    margin-right: 1;
    scrollbar-size-vertical: 1;
    scrollbar-gutter: stable;
}

#dashboard-right {
    width: 1fr;
    min-width: 38;
    height: 100%;
}

#engine-row {
    height: auto;
}

#engine-row > InfoPanel {
    width: 1fr;
    /* Tor's full panel is 11 rows; matching it keeps the pair level. */
    min-height: 11;
}

#engine-row > InfoPanel:first-child {
    margin-right: 1;
}

/* --------------------------------------------------------------------- *
 * Panels
 * --------------------------------------------------------------------- */

InfoPanel {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    padding: 0 1;
    background: $ink-panel;
    border: round $ink-line;
    border-title-color: $ink-muted;
    border-title-style: bold;
    color: $ink-text;
}

InfoPanel.-fills-column {
    height: 1fr;
    margin-bottom: 0;
}

InfoPanel:focus {
    border: round $accent-deep;
    border-title-color: $accent;
    background: $ink-raised;
}

/* Engine state shows on the border title, not as a flood of colour. */
InfoPanel.-panel-active {
    border-title-color: $ok;
}

InfoPanel.-panel-busy {
    border-title-color: $busy;
}

InfoPanel.-panel-error {
    border: round $err;
    border-title-color: $err;
}

InfoPanel.-panel-unused {
    color: $ink-faint;
    border-title-color: $ink-faint;
}

/* The route hero: the first thing the eye lands on. */
InfoPanel#panel-routing {
    padding: 0 2;
    min-height: 7;
}

InfoPanel#panel-routing.-panel-active {
    border: round $ok;
}

InfoPanel#panel-routing.-panel-warn {
    border: round $warn;
    border-title-color: $warn;
}

InfoPanel#panel-routing.-panel-busy {
    border: round $busy;
}

CountdownPanel {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    background: $ink-panel;
    border: round $ink-line;
    border-title-color: $ink-muted;
    border-title-style: bold;
}

CountdownPanel:focus {
    border: round $accent-deep;
    border-title-color: $accent;
    background: $ink-raised;
}

ActivityLog {
    height: 1fr;
    padding: 0 1;
    background: $ink-panel;
    border: round $ink-line;
    border-title-color: $ink-muted;
    border-title-style: bold;
    scrollbar-size-vertical: 1;
}

ActivityLog:focus {
    border: round $accent-deep;
    border-title-color: $accent;
}

/* --------------------------------------------------------------------- *
 * Navigation menu
 * --------------------------------------------------------------------- */

NavMenu {
    height: auto;
    max-height: 22;
    margin-bottom: 1;
    padding: 0 0 1 0;
    background: $ink-panel;
    border: round $ink-line;
    border-title-color: $ink-muted;
    border-title-style: bold;
    scrollbar-size-vertical: 1;
}

NavMenu:focus {
    border: round $accent-deep;
    border-title-color: $accent;
}

NavMenu > ListItem {
    padding: 0 1;
    background: $ink-panel;
    color: $ink-text;
}

NavMenu > ListItem.menu-section {
    padding: 1 1 0 1;
    background: $ink-panel;
}

NavMenu > ListItem.menu-section:first-of-type {
    padding: 0 1 0 1;
}

/* Selection: a recessed violet row with an accent edge -- never a flood. */
NavMenu > ListItem.-highlight {
    background: $ink-raised;
    color: $ink-text;
}

NavMenu:focus > ListItem.-highlight {
    background: $ink-select;
    color: $ink-text;
    text-style: bold;
    border-left: outer $accent;
    padding-left: 0;
}

NavMenu > ListItem.-hovered {
    background: $ink-raised;
}

/* --------------------------------------------------------------------- *
 * Generic screens
 * --------------------------------------------------------------------- */

.screen-title {
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.screen-hint {
    height: auto;
    padding: 1 2 0 2;
    color: $ink-muted;
}

.screen-body {
    height: 1fr;
    margin: 1 1 0 1;
    padding: 0 1;
    background: $ink-panel;
    border: round $ink-line;
    border-title-color: $ink-muted;
    border-title-style: bold;
}

.screen-body:focus-within {
    border: round $accent-deep;
    border-title-color: $accent;
}

DataTable {
    height: 1fr;
    background: $ink-panel;
    color: $ink-text;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: $ink-panel;
    color: $ink-faint;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $ink-select;
    color: $ink-text;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $ink-raised;
}

DataTable > .datatable--even-row {
    background: $ink-panel;
}

ListView {
    background: $ink-panel;
    scrollbar-size-vertical: 1;
}

ListView > ListItem {
    padding: 0 1;
    background: $ink-panel;
    color: $ink-text;
}

ListView > ListItem.-highlight {
    background: $ink-raised;
    color: $ink-text;
}

ListView:focus > ListItem.-highlight {
    background: $ink-select;
    color: $ink-text;
    text-style: bold;
}

ListView > ListItem.-hovered {
    background: $ink-raised;
}

RichLog {
    background: $ink-panel;
    color: $ink-text;
    scrollbar-size-vertical: 1;
}

Input {
    background: $ink-raised;
    color: $ink-text;
    border: round $ink-line;
}

Input:focus {
    border: round $accent-deep;
}

Button {
    background: $ink-raised;
    color: $ink-text;
    border: none;
    min-width: 12;
    height: 1;
    margin-top: 1;
}

Button:hover {
    background: $ink-select;
}

Button:focus {
    background: $accent-deep;
    color: $ink-text;
    text-style: bold;
}

Button.-primary {
    background: $ink-select;
}

Button.-primary:focus {
    background: $accent-deep;
}

Button.-error:focus {
    background: $err;
    color: $ink-bg;
}

Switch {
    background: $ink-raised;
}

Switch > .switch--slider {
    background: $ink-line;
    color: $ok;
}

#mode-list-column {
    width: 58;
    margin-right: 2;
}

#mode-list {
    height: auto;
}

#mode-list > ListItem {
    padding: 1 1;
}

#mode-detail-column {
    width: 1fr;
    padding: 1 0;
}

/* --------------------------------------------------------------------- *
 * Modals
 * --------------------------------------------------------------------- */

ConfirmScreen,
PromptScreen,
ReportScreen {
    align: center middle;
    background: $ink-bg 70%;
}

.modal-box {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $ink-panel;
    border: round $accent-deep;
    border-title-color: $accent;
    border-title-style: bold;
}

.modal-question {
    height: auto;
    padding-bottom: 1;
    color: $ink-text;
}

.modal-hint {
    height: auto;
    padding-bottom: 1;
    color: $ink-muted;
}

.modal-actions {
    height: auto;
    align: right middle;
}

.modal-actions Button {
    margin-left: 2;
}

/* --------------------------------------------------------------------- *
 * About
 * --------------------------------------------------------------------- */

#about-banner {
    height: auto;
    content-align: center middle;
}

#about-card {
    width: 100%;
    height: auto;
    margin: 0 1;
    padding: 1 2;
    background: $ink-panel;
    border: round $ink-line;
}

/* --------------------------------------------------------------------- *
 * Verification / doctor report
 * --------------------------------------------------------------------- */

#report-log {
    height: 18;
}

.report-summary {
    height: auto;
    padding: 1 0 0 0;
    text-style: bold;
}
